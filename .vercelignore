# Keeps ~84MB out of every deployment upload. Mirrors .gitignore, but this file
# is what Vercel actually reads — .gitignore does not apply to CLI deploys.
#
# Anything the build needs must NOT be listed here:
#   src/ scripts/ server/ public/ migrations/ package.json vite.config.ts
#   tsconfig.json .grok/app-env.json  (read by scripts/with-app-env.mjs)

node_modules/
.node_modules.lock

# Build output and caches — regenerated by the build itself.
.vercel/
.tanstack/
dist/
*.tsbuildinfo

# Local design sources and dev captures (OrbyUI.fig alone is 56MB).
attachments/
screenshots/
artifacts/

# Local version snapshots.
.snapshots/

# Agent scaffolding, except the build-affecting env file.
.grok/*
!.grok/app-env.json

# Repo docs and tooling that play no part in the build.
AGENTS.md
.git/
.gitignore
.prettierrc
eslint.config.mjs

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
